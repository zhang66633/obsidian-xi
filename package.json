{
	"name": "xi-qwen",
	"version": "0.5.0",
	"description": "希XI (Xi Qwen) — bilingual Qwen assistant for Obsidian: understand, organize and integrate your vault",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run lint && npm run test && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"qwen",
		"rag",
		"bilingual",
		"notes"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/zhang66633/obsidian-xi.git"
	},
	"homepage": "https://community.obsidian.md/plugins/xi-qwen",
	"bugs": {
		"url": "https://github.com/zhang66633/obsidian-xi/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"obsidian": "1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "^3.2.4"
	}
}
